rules_version = '2';
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // The one Google account allowed to edit game content (admin.html). The email must be verified by Google.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'mendus59@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isContent() {
      return request.resource.data.keys().hasOnly(['data', 'updatedAt', 'by', 'note'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 500000;
    }

    // Each signed-in player can read and write only their own save, stored at users/{their uid}.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Game content published from the admin page. Every player reads content/live (signed in or not);
    // only the admin can read the draft or write anything.
    match /content/{docId} {
      allow read: if docId == 'live' || isAdmin();
      allow write: if isAdmin() && docId in ['live', 'draft'] && isContent();
    }
    // One entry per publish, so an older version can be loaded back.
    match /contentHistory/{entry} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isContent();
    }
  }
}
